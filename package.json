    "review": "node scripts/review.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/check.mjs && node scripts/build.mjs",
    "release": "node scripts/check.mjs --net && node scripts/build.mjs",
    "flow": "node scripts/discover.mjs && node scripts/review.mjs",
    "merge": "node scripts/merge.mjs",
    "probe": "node scripts/probe.mjs",
    "select": "node scripts/select.mjs",
    "xlsx": "python scripts/make_xlsx.py",
