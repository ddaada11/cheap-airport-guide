{
  "name": "airport-guide",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "机场推荐：采集候选 → 人工填邀请码 → 自动生成 README",
  "scripts": {
    "discover": "node scripts/discover.mjs",
    "harvest": "node scripts/harvest.mjs",
    "enrich": "node scripts/enrich.mjs",
