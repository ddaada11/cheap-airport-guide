    "topic": "node scripts/topic-lean.mjs",
    "paolu": "node scripts/paolu.mjs",
    "verify2": "node scripts/verify.mjs",
    "final": "node scripts/final-pool.mjs",
    "cards": "node scripts/cards.mjs",
    "tg": "node scripts/tg.mjs",
    "topic:lean": "node scripts/topic-lean.mjs",
    "verify:real": "node scripts/verify-real.mjs",
    "check:site": "node scripts/check-site.mjs",
    "readme": "node scripts/build-readme.mjs",
    "daily": "node scripts/daily-check.mjs",
    "readme2": "node scripts/build-readme2.mjs"
  }
}
